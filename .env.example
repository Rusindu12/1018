# Keep secrets on the private backend host. Never paste Binance secrets into the APK.
# Generate a long random token: openssl rand -hex 32
APP_ACCESS_TOKEN=replace-with-at-least-64-random-hex-characters
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Start in Spot Testnet. To enable REAL spot orders, set both explicitly:
# BINANCE_TESTNET=false
# LIVE_TRADING_ENABLED=true
BINANCE_TESTNET=true
LIVE_TRADING_ENABLED=false

# Strict backend-enforced market-order caps (USDT)
MAX_ORDER_USDT=25
MIN_ORDER_USDT=10

# Add only the origins used by your app. Capacitor Android is normally https://localhost.
# If testing from the Arena/Vite preview, add that exact https://...e2b.app origin.
APP_ORIGINS=https://localhost,http://localhost:5173

PORT=8787
HOST=127.0.0.1
