# === AI Binance Trader — Backend Environment ===
# Copy to .env and fill in. NEVER commit .env with real secrets.

APP_NAME=AI Binance Trader
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://your-frontend.example.com

# Security — GENERATE with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY_44_CHARS_BASE64==
JWT_SECRET=REPLACE_WITH_RANDOM_32+_CHARS_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# Database — Postgres recommended; SQLite for quick dev
DATABASE_URL=sqlite:///./ai_binance_trader.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ai_binance_trader
REDIS_URL=redis://localhost:6379/0

# Binance — Start with Testnet=true
BINANCE_API_BASE=https://api.binance.com
BINANCE_TESTNET=true
BINANCE_TESTNET_BASE=https://testnet.binance.vision
BINANCE_WS_BASE=wss://stream.binance.com:9443
BINANCE_WS_TESTNET_BASE=wss://testnet.binance.vision

# Trading defaults (overridable per user)
DEFAULT_MAX_TRADE_USDT=100
DEFAULT_DAILY_LOSS_LIMIT_USDT=50
DEFAULT_MAX_OPEN_POSITIONS=3
DEFAULT_COOLDOWN_MINUTES=15
DEFAULT_TRADING_MODE=paper  # paper | manual | live_auto
PAPER_INITIAL_BALANCE_USDT=10000

# WebSocket
WS_HEARTBEAT_SECONDS=30
WS_RECONNECT_MAX_RETRIES=10

# Monitoring
SENTRY_DSN=
ENABLE_STRUCTURED_LOGGING=true

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
BINANCE_RECV_WINDOW=5000
BINANCE_ORDER_RETRY=3

# Feature flags
ENABLE_LIVE_TRADING=false
REQUIRE_LIVE_CONFIRMATION=true
