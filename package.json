{
  "name": "neuralab-cryptolab",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Bilingual crypto market education and paper-trading practice app. No real orders or exchange keys.",
  "scripts": {
    "start": "node server.js",
    "start:backend": "node backend/server.js",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:crypto": "node --test tests/crypto*.test.mjs",
    "android:sync": "npm run build && cap sync android"
  },
  "engines": { "node": ">=18" },
  "license": "Apache-2.0",
  "keywords": ["crypto", "paper-trading", "market-analysis", "sinhala", "capacitor", "android"],
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "vite": "^6.4.1"
  }
}
